{% extends 'base.html.twig' %}

{% block title %}Confirmation de compte{% endblock %}

{% block contenu_page %}
<section class="h-full relative">
    <div class="bg-cover bg-no-repeat h-full before:bg-black/40" style="background-image: url('https://blog.compose.fr/wp-content/uploads/2024/05/Marathon-Cinema.webp');">
        <div class="p-8 lg:w-1/2 mx-auto h-full flex items-center justify-center">
            <div class="bg-white rounded-lg p-8 relative w-full">
                <h1 class="text-center text-lg font-bold">Confirmation de compte</h1>
                <p class="text-center mt-5">Votre compte a été confirmé avec succès. Vous pouvez désormais vous connecter.</p>
                <div class="mt-8 text-center">
                    <a href="{{ path('app_login') }}" class="text-red-600 hover:text-red-700">Se connecter</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
