{% extends 'base.html.twig' %}

{% block title %}Accueil - Streemi{% endblock %}

{% block contenu_page %}
    <!-- Section de navigation -->
    <section>
        <nav class="flex space-x-6 text-gray-400 font-medium">
            <a href="{{ path('app_series') }}" class="hover:text-gray-700">Séries</a>
            <a href="{{ path('app_movies') }}" class="text-gray-700 font-semibold">Films</a>
        </nav>
    </section>

    <!-- Section Tendances -->
    <section class="mt-9">
        <div class="flex items-center justify-between">
            <span class="font-semibold text-gray-700 text-base">Tendances</span>
        </div>
        <ul class="mt-4 grid grid-cols-2 gap-y-5 sm:grid-cols-3 gap-x-5">
            {% for movie in trendingMovies %}
                {% include 'parts/movie_card_homepage.html.twig' with {'movie': movie} %}
            {% endfor %}
        </ul>
    </section>

    <!-- Section Commentaires -->
    <section class="mt-9">
        <h2 class="text-lg font-bold mb-4">Commentaires récents</h2>
        {% for comment in comments %}
            {% include 'parts/comment/comment_card.html.twig' with {'comment': comment} %}
        {% else %}
            <p class="text-gray-500">Aucun commentaire pour le moment.</p>
        {% endfor %}
    </section>

    <!-- Section Abonnements -->
    <section class="mt-9">
        <h2 class="text-lg font-bold mb-4">Abonnements</h2>
        <div class="grid grid-cols-2 gap-4">
            {% for subscription in subscriptions %}
                {% include 'parts/subscription/subscription_card.html.twig' with {'subscription': subscription} %}
            {% endfor %}
        </div>
    </section>
{% endblock %}
