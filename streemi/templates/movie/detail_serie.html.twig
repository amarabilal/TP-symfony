{% extends 'base.html.twig' %}

{% block title %}
   {{ parent() }} Détails de la série
{% endblock %}

{% block contenu_page %}
    <section>
        <div class="bg-gray-100 rounded-lg p-5 shadow-md">
            <h1 class="text-2xl font-bold text-red-600">{{ serie.title }}</h1>
            <p class="mt-3">{{ serie.longDescription }}</p>
            <p class="mt-2 text-sm text-gray-500">Date de sortie : {{ serie.releaseDate|date('d/m/Y') }}</p>
            <p class="mt-2 text-sm text-gray-500">Saisons : {{ serie.seasons|length }}</p>
        </div>

        <div class="mt-5">
            <h2 class="text-xl font-semibold mb-3">Saisons et épisodes</h2>
            {% for season in serie.seasons %}
                <div class="mb-4">
                    <h3 class="text-lg font-bold">Saison {{ season.number }}</h3>
                    <ul class="list-disc pl-5">
                        {% for episode in season.episodes %}
                            <li>{{ episode.title }} - {{ episode.duration }} minutes</li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <p>Aucune saison trouvée pour cette série.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
