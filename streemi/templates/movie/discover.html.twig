{% extends 'base.html.twig' %}

{% block title %}Découvrir{% endblock %}

{% block contenu_page %}
<section>
    <h1 class="text-2xl font-bold mb-5">Découvrir</h1>
    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4">
        {% for media in recommendedMovies %}
            <div class="p-4 bg-gray-100 rounded-lg shadow-md">
                <img src="{{ media.thumbnail }}" alt="{{ media.name }}" class="rounded-lg w-full h-48 object-cover">
                <h2 class="mt-3 text-lg font-semibold">{{ media.name }}</h2>
                <p class="text-sm text-gray-500">
                    {% if media is instance of('App\\Entity\\Movie') %}
                        Film
                    {% elseif media is instance of('App\\Entity\\Serie') %}
                        Série
                    {% endif %}
                </p>
            </div>
        {% else %}
            <p>Aucun média trouvé pour l'instant.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
