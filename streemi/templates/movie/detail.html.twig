{% extends 'base.html.twig' %}

{% block title %}
   {{ parent() }} Détails du film
{% endblock %}

{% block contenu_page %}
    <section>
        <div class="bg-gray-100 rounded-lg p-5 shadow-md">
            <h1 class="text-2xl font-bold text-red-600">{{ movie.title }}</h1>
            <p class="mt-3">{{ movie.longDescription }}</p>
            <p class="mt-2 text-sm text-gray-500">Date de sortie : {{ movie.releaseDate|date('d/m/Y') }}</p>
        </div>

        <div class="mt-5">
            <h2 class="text-xl font-semibold mb-3">Casting</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                {% for actor in movie.casting %}
                    {% include 'movie/casting_card.html.twig' with { 'actor': actor } %}
                {% endfor %}
            </div>
        </div>

        <div class="mt-5">
            <h2 class="text-xl font-semibold mb-3">Commentaires</h2>
            <ul class="space-y-3">
                {% for comment in movie.comments %}
                    {% include 'comment/comment_card.html.twig' with { 'comment': comment } %}
                {% else %}
                    <p>Aucun commentaire pour ce film.</p>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endblock %}
