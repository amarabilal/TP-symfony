{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block contenu_page %}
<section class="h-full flex items-center justify-center">
    <div class="w-full max-w-md bg-white shadow-md rounded-lg p-8">
        <h1 class="text-2xl font-bold text-center text-gray-700 mb-6">Connexion</h1>

        {% if error %}
            <div class="mb-4 text-sm text-red-600 bg-red-100 p-3 rounded-md">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-4 text-sm text-gray-600">
                Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                <a href="{{ path('app_logout') }}" class="text-red-600 hover:underline">Déconnexion</a>
            </div>
        {% endif %}

        <form method="post">
            <!-- Email -->
            <div class="mb-4">
                <label for="username" class="block text-sm font-medium text-gray-700">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}"
                       class="mt-1 block w-full px-4 py-2 border rounded-lg shadow-sm focus:ring-red-600 focus:border-red-600"
                       placeholder="Votre adresse email" autocomplete="email" required autofocus>
            </div>

            <!-- Mot de passe -->
            <div class="mb-4">
                <label for="password" class="block text-sm font-medium text-gray-700">Mot de passe</label>
                <input type="password" id="password" name="_password"
                       class="mt-1 block w-full px-4 py-2 border rounded-lg shadow-sm focus:ring-red-600 focus:border-red-600"
                       placeholder="Votre mot de passe" autocomplete="current-password" required>
            </div>

            <!-- CSRF Token -->
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <!-- Soumission -->
            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg">
                Connexion
            </button>

            <!-- Lien mot de passe oublié -->
            <div class="text-center mt-4">
                <a href="{{ path('forgot_password') }}" class="text-sm text-gray-500 hover:text-red-600">
                    Mot de passe oublié ?
                </a>
            </div>
        </form>
    </div>
</section>
{% endblock %}
