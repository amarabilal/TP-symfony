{% extends 'base.html.twig' %}

{% block title %}Mes Playlists{% endblock %}

{% block contenu_page %}
<section>
    <h1 class="text-lg font-medium text-gray-700 mb-5">
        Mes <span class="font-bold text-red-600">Playlists</span>
    </h1>

    <!-- Options pour gérer les playlists -->
    <div class="flex space-x-4 mb-5">
        <button class="flex items-center px-4 py-2 border rounded hover:bg-gray-100">
            <svg class="h-5 w-5 mr-2 fill-current" viewBox="0 0 24 24"><path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" /></svg>
            Créer une playlist
        </button>
    </div>

    <!-- Sélecteur des playlists -->
    <div class="relative mb-5">
        <select class="w-full px-4 py-3 border rounded shadow">
            {% for playlist in playlists %}
                <option value="{{ playlist.id }}">
                    {{ playlist.name }} ({{ playlist.allMoviePlaylistMedia|length }} films, {{ playlist.allSeriePlaylistMedia|length }} séries)
                </option>
            {% endfor %}
        </select>
    </div>

    <!-- Affichage des playlists -->
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-5">
        {% for playlistMedia in activePlaylist.playlistMedia %}
            {% include 'parts/movie_card_big.html.twig' with { 'media': playlistMedia.media } %}
        {% else %}
            <p class="text-gray-500 col-span-3">Aucun média trouvé dans cette playlist.</p>
        {% endfor %}
    </ul>
</section>
{% endblock %}
