{% extends 'base.html.twig' %}

{% block title %}
   {{ parent() }} Découvrir
{% endblock %}

{% block contenu_page %}
    <section>
        <h1 class="text-lg font-bold text-gray-700 mb-5">Découvrir</h1>
        <nav class="flex space-x-6 text-gray-400 font-medium mb-5">
            <a href="#" class="hover:text-gray-700">Séries</a>
            <a href="#" class="text-gray-700 font-semibold">Films</a>
            <a href="#" class="hover:text-gray-700">Animés</a>
        </nav>

        <div class="mt-5">
            <h2 class="text-xl font-semibold mb-3">Recommandations</h2>
            <ul class="grid grid-cols-2 sm:grid-cols-3 gap-5">
                {% for movie in recommendedMovies %}
                    {% include 'parts/movie_card_homepage.html.twig' %}
                {% endfor %}
            </ul>
        </div>

        <div class="mt-5">
            <h2 class="text-xl font-semibold mb-3">Par Catégories</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-5">
                {% for category in categories %}
                    {% include 'parts/card_category.html.twig' %}
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
