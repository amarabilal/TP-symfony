{% extends 'base.html.twig' %}

{% block title %}Abonnements{% endblock %}

{% block contenu_page %}
<section>
    <h1 class="text-lg font-medium text-gray-700 mb-5">
        Nos <span class="font-bold text-red-600">Abonnements</span>
    </h1>
    <p class="text-gray-400 text-sm mb-8">
        Profitez de notre catalogue exclusif de films & séries à prix compétitif.
    </p>

    {% if app.user %}
        <div class="bg-gray-100 text-gray-700 rounded-lg px-6 py-4 mb-5">
            <p>Votre abonnement actuel : 
                <span class="font-bold text-red-600">
                    {{ app.user.currentSubscription.name|default('Aucun') }}
                </span>
            </p>
        </div>
    {% endif %}

    <ul class="grid grid-cols-2 gap-5">
        {% for subscription in subscriptions %}
            {% include 'subscription/subscription_card.html.twig' with { 'subscription': subscription } %}
        {% else %}
            <p class="text-gray-500">Aucun abonnement disponible pour le moment.</p>
        {% endfor %}
    </ul>
</section>
{% endblock %}
