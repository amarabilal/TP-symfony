{% extends 'base.html.twig' %}

{% block title %}Mes listes{% endblock %}

{% block contenu_page %}
<section>
    <h1 class="text-2xl font-bold mb-5">Mes listes</h1>
    <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4">
        {% for playlist in playlists %}
            <li class="p-4 bg-gray-100 rounded-lg shadow-md">
                <h2 class="text-lg font-semibold">{{ playlist.name }}</h2>
                <p class="text-sm text-gray-500">Créée le {{ playlist.createdAt|date('d/m/Y') }}</p>
            </li>
        {% else %}
            <p>Vous n'avez pas encore de listes.</p>
        {% endfor %}
    </ul>
</section>
{% endblock %}
