<div class="border rounded-lg p-4 shadow hover:shadow-lg transition">
    <h3 class="text-lg font-bold text-gray-700">{{ subscription.name }}</h3>
    <p class="text-sm text-gray-500 mb-3">Durée : {{ subscription.duration }} mois</p>
    <p class="text-xl font-semibold text-red-600">{{ subscription.price }} €</p>
    <a href="{{ path('subscribe_plan', {id: subscription.id}) }}"
       class="block mt-3 text-center bg-red-600 text-white py-2 rounded hover:bg-red-700">
        S'abonner
    </a>
</div>
